  - m_Id: 351479409856549
    m_Localized: "\u5E02\u573A\u4EA4\u6613\u4E0E\u7ADE\u62CD\u6307\u5357"
    m_Metadata:
      m_Items: []
  - m_Id: 351479409856550
    m_Localized: "\u7532\u866B\u5546\u5E97 / \u6536\u85CF\u5E02\u573A / \u516C\u5F00\u62CD\u5356"
    m_Metadata:
      m_Items: []
  - m_Id: 351479409856551
    m_Localized: "1. \u5546\u5E97\u4E0E\u90AE\u7BB1\n\u6D3B\u4F53\u3001\u88C5\u6846\u6807\u672C\u4E0E\u7528\u54C1\u5747\u6709\u660E\u7801\u6807\u4EF7\u3002\u7528\u54C1\u53EF\u6309
      1\u201399 \u4EF6\u6279\u91CF\u8D2D\u4E70\u3002\u6240\u6709\u8BA2\u5355\u901A\u8FC7\u90AE\u7BB1\u9886\u53D6\uFF1A\u6D3B\u4F53\u5B58\u5165\u4ED3\u5E93\uFF0C\u6807\u672C\u5B58\u5165\u6536\u85CF\u5E93\u3002\n\n2.
      \u51FA\u552E\u6536\u85CF\u4E0E\u5E93\u5B58\n\u5546\u5E97\u5373\u65F6\u56DE\u6536\u4EF7\uFF1A\u6210\u866B\u4F30\u4EF7\u7684
      55%\uFF08\u5E7C\u866B 35%\uFF09\uFF0C\u6807\u672C\u4F30\u4EF7\u7684 60%\uFF0C\u7528\u54C1\u96F6\u552E\u4EF7\u7684
      40%\u3002\u663E\u793A\u7684\u56DE\u6536\u4EF7\u5C31\u662F\u5B9E\u6536\u91D1\u5E01\u3002\n\n3.
      \u4EA4\u6613 \u544A\u793A\u677F\n\u5065\u5EB7\u6210\u866B\u4E0E\u6807\u672C\u5171\u7528\u6302\u724C\u5C55\u67DC\u3002\u6302\u724C\u514D\u8D39\uFF0C\u6BCF\u5468\u5237\u65B0\u4E70\u5BB6\u62A5\u4EF7\uFF1B\u6210\u4EA4\u6536\u53D6
      5% \u624B\u7EED\u8D39\u3002\u6210\u4EA4\u524D\u53EF\u4EE5\u64A4\u56DE\u3002\u6807\u672C\u6302\u724C\u65F6\u4F1A\u4ECE\u5C55\u793A\u5899\u53D6\u4E0B\u3002\n\n4.
      \u516C\u5F00\u62CD\u5356\n\u6BCF\u573A\u56DB\u8F6E\uFF0C\u81EA\u5B9A\u4E49\u4E3E\u724C\u540E\u70B9\u51FB\u300C\u4E0B\u4E00\u8F6E\u300D\u67E5\u770B\u5176\u4ED6\u4E70\u5BB6\u56DE\u5E94\u3002\u53EA\u6709\u843D\u69CC\u65F6\u6700\u9AD8\u51FA\u4EF7\u8005\u53C2\u4E0E\u6210\u4EA4\u5224\u5B9A\u3002\u8FBE\u5230\u671F\u671B\u4EF7\u65F6\u5FC5\u5B9A\u6210\u4EA4\uFF1B\u4F4E\u4E8E\u671F\u671B\u4EF7\u65F6\uFF0C\u63A5\u53D7\u7387\u4E3A\u4EF7\u683C\u6BD4\u4F8B\u7684\u5E73\u65B9\u3002\u51FA\u4EF7\u6682\u5B58\u6258\u7BA1\uFF0C\u88AB\u8D85\u4EF7\u6216\u6D41\u62CD\u81EA\u52A8\u9000\u6B3E\u3002\n\n5.
      \u6BCF\u5468\u8865\u8D27\u4E0E\u4FDD\u5B58\n\u8FDB\u5165\u4E0B\u4E00\u5468\u4F1A\u7ED3\u7B97\u672A\u7ED3\u675F\u62CD\u5356\uFF0C\u518D\u66F4\u65B0\u8D27\u67B6\u548C\u62CD\u54C1\u3002\u6BCF\u6B21\u6210\u529F\u4EA4\u6613\u90FD\u4F1A\u4FDD\u5B58\u3002Alt+T
      \u67E5\u770B\u4E3B\u9898\uFF0CAlt+M \u5207\u6362\u660E\u6697\uFF0CAlt+H \u67E5\u770B\u5E2E\u52A9\u3002"
    m_Metadata:
      m_Items: []
