    m_Localized: "Total age: {0} days \xB7 Active adult age: {1} days"
    m_Metadata:
      m_Items: []
  - m_Id: 364787395383352
    m_Localized: "Preserve \xB7 {0} G"
    m_Metadata:
      m_Items: []
  - m_Id: 364787395383353
    m_Localized: Discard this dead beetle? It can no longer become a specimen.
    m_Metadata:
      m_Items: []
  - m_Id: 364787395383354
    m_Localized: "Rearing supplies \xB7 Choose a beetle"
    m_Metadata:
      m_Items: []
