    m_Metadata:
      m_Items: []
  - m_Id: 364787395383343
    m_Localized: Estimated adult size
    m_Metadata:
      m_Items: []
  - m_Id: 364787395383344
    m_Localized: "Live beetles are valued by stage \xB7 Specimens: 60% of appraisal
      \xB7 Supplies: 40% of retail. Try the Trading BBS for higher offers."
    m_Metadata:
      m_Items: []
  - m_Id: 364787395383345
    m_Localized: Ready to sell
    m_Metadata:
      m_Items: []
  - m_Id: 364787395383346
    m_Localized: Match supplies to life stages. Storage provides care, but beetles
      keep growing and adults still age naturally.
    m_Metadata:
      m_Items: []
  - m_Id: 364787395383347
    m_Localized: Unsuitable for current stage
    m_Metadata:
      m_Items: []
