    m_Metadata:
      m_Items: []
  - m_Id: 364787395383332
    m_Localized: 'Default: 180 days / 6 months'
    m_Metadata:
      m_Items: []
  - m_Id: 364787395383333
    m_Localized: Reset stage durations
    m_Metadata:
      m_Items: []
  - m_Id: 364787395383334
    m_Localized: Dormancy is separate. Active adults receive a full 180 days by default.
    m_Metadata:
      m_Items: []
  - m_Id: 364787395383335
    m_Localized: "New durations preserve current stage progress and total age. Each
      stage accepts 0.25\u20133650 days."
    m_Metadata:
      m_Items: []
  - m_Id: 364787395383336
    m_Localized: Save and return
    m_Metadata:
      m_Items: []
  - m_Id: 364787395383337
    m_Localized: Enter valid real minutes, from 1/6 to 1440.
    m_Metadata:
      m_Items: []
  - m_Id: 364787395383338
    m_Localized: Enter valid stage days, from 0.25 to 3650.
    m_Metadata:
